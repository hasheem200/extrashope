# ==========================================================
# Optional environment variables for deployment.
# None of these are strictly required to run — the app has
# safe fallbacks for local development — but setting them on
# your hosting platform (Railway → Variables, etc.) is
# recommended for production.
# ==========================================================

# MongoDB connection string. If not set, falls back to the
# connection string already in server.js. Recommended: move your
# real connection string here and rotate the database password,
# since it has been sitting directly in the source code.
MONGO_URI=

# The port the server listens on. Most hosting platforms (Railway,
# Render, Heroku) set this automatically — you usually don't need
# to set it yourself.
PORT=5001

# Set to "production" on your live server. Enables the HTTPS
# redirect safety net (see server.js) and can be checked by any
# code that wants to behave differently between local dev and the
# live site.
NODE_ENV=production
